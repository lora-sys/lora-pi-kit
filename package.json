{
  "name": "@lora-sys/pi-kit",
  "version": "0.1.1",
  "description": "Lora's reproducible Pi distribution for local coding, Glassbox Personal Agent execution, and Herdr workers",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "keywords": [
    "pi-package",
    "coding-agent",
    "glassbox",
    "lora"
  ],
  "pi": {
    "extensions": [
      "./extensions/core/*.ts",
      "./extensions/glassbox/*.ts",
      "./extensions/mcp/tool-adapter.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "doctor": "node bin/doctor.js",
    "sync-skills": "node dist/scripts/sync-skills.js",
    "install-kit": "node dist/scripts/install.js",
    "update-kit": "node dist/scripts/update.js",
    "run-profile": "node dist/scripts/run.js",
    "lock-sandbox-image": "node dist/scripts/lock-sandbox-image.js",
    "sandbox-smoke": "node dist/scripts/sandbox-smoke.js",
    "prepare": "npm run build"
  },
  "bin": {
    "lora-doctor": "./bin/doctor.js"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@sinclair/typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@sinclair/typebox": "^0.34.47",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src/paths.ts",
    "src/types.ts",
    "extensions",
    "skills",
    "prompts",
    "profiles",
    "mcp",
    "config",
    "locks",
    "bin",
    "README.md",
    "LICENSE",
    "tests/fixtures/test-mcp-server.js"
  ]
}
